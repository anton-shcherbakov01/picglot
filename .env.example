# =============================================================================
# PicGlot — environment configuration
# Copy to .env and adjust. Every variable is documented in docs/operations/
# configuration.md. Values marked REQUIRED-PROD abort startup in production
# if left at the development default (see picglot/core/config.py).
# =============================================================================

# -----------------------------------------------------------------------------
# Branding / product identity  (single source of truth for the product name)
# -----------------------------------------------------------------------------
BRAND_NAME=PicGlot
BRAND_LEGAL_ENTITY=PicGlot
BRAND_SUPPORT_EMAIL=support@picglot.ru
BRAND_DOMAIN=picglot.ru
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production | test
DEBUG=true
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                # console | json  (use json in production)
MAINTENANCE_MODE=false

# REQUIRED-PROD. Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-insecure-secret-key-change-me-in-production-0000000000000000
# Comma separated. Used for cookie/session signing rotation (first = active).
SECRET_KEY_PREVIOUS=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# The app itself only reads DATABASE_URL. POSTGRES_USER/PASSWORD/DB below exist
# for docker-compose.production.yml, which passes them straight to the official
# postgres image and to the backup container — they are NOT read by picglot
# itself, so keep them in sync with the credentials embedded in DATABASE_URL by
# hand. In production, the host in DATABASE_URL must be the compose service
# name (`postgres`), not `localhost`.
DATABASE_URL=postgresql+psycopg://picglot:picglot@localhost:5432/picglot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false
# REQUIRED for docker-compose.production.yml (postgres, migrate, backup services).
POSTGRES_USER=picglot
POSTGRES_PASSWORD=picglot
POSTGRES_DB=picglot

# -----------------------------------------------------------------------------
# Redis (cache, rate limiting, queue broker, distributed locks)
# -----------------------------------------------------------------------------
# REQUIRED-PROD. docker-compose.production.yml starts Redis with
# `--requirepass ${REDIS_PASSWORD}` — once that's set, REDIS_URL must embed the
# same password (redis://:<password>@redis:6379/0) or the app will fail to
# connect. Left blank / no auth in development.
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Queue
# -----------------------------------------------------------------------------
# celery  -> distributed workers (production)
# inline  -> in-process thread pool, no broker required (local dev / tests)
QUEUE_BACKEND=celery
QUEUE_DEFAULT=cpu
QUEUE_GPU_ENABLED=false
JOB_MAX_ATTEMPTS=3
JOB_SOFT_TIME_LIMIT_SECONDS=900
JOB_HARD_TIME_LIMIT_SECONDS=1200
JOB_STUCK_AFTER_SECONDS=1800
MAX_CONCURRENT_JOBS_PER_USER=3
MAX_CONCURRENT_JOBS_PER_WORKSPACE=10

# -----------------------------------------------------------------------------
# Object storage (S3 compatible; MinIO locally)
# -----------------------------------------------------------------------------
STORAGE_BACKEND=s3                # s3 | local
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=picglot
S3_SECRET_ACCESS_KEY=picglot-dev-secret
S3_BUCKET=picglot
S3_FORCE_PATH_STYLE=true
S3_USE_SSL=false
S3_SERVER_SIDE_ENCRYPTION=          # e.g. AES256 (leave blank for MinIO dev)
SIGNED_URL_TTL_SECONDS=900
# The editor loads pages onto a canvas, so storage must answer with CORS
# headers. Set this to your site origin in production, e.g. https://picglot.ru
MINIO_CORS_ALLOW_ORIGIN=*
# Only used when STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/storage

# -----------------------------------------------------------------------------
# Upload limits / safety
# -----------------------------------------------------------------------------
MAX_UPLOAD_BYTES_GUEST=10485760          # 10 MB
MAX_UPLOAD_BYTES_FREE=10485760           # 10 MB
MAX_UPLOAD_BYTES_PRO=104857600           # 100 MB
MAX_UPLOAD_BYTES_BUSINESS=209715200      # 200 MB
MAX_IMAGE_PIXELS=80000000                # decompression-bomb guard
MAX_PDF_PAGES_GUEST=3
MAX_PDF_PAGES_FREE=10
MAX_PDF_PAGES_PRO=300
MAX_PDF_PAGES_BUSINESS=1000
MAX_BATCH_FILES_FREE=5
MAX_BATCH_FILES_PRO=50
MAX_BATCH_FILES_BUSINESS=100
ALLOW_SVG_UPLOAD=false
ANTIVIRUS_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# -----------------------------------------------------------------------------
# Locales / languages
# -----------------------------------------------------------------------------
DEFAULT_LOCALE=en
ENABLED_LOCALES=en,ru,es,de,fr,pt,tr,id,pl,uk

# -----------------------------------------------------------------------------
# OCR providers  (comma separated priority list, first healthy wins)
# Available: rapidocr, tesseract, google_vision, azure_vision, aws_textract,
#            yandex_vision, llm
# -----------------------------------------------------------------------------
OCR_PROVIDER_PRIORITY=rapidocr,tesseract
OCR_HANDWRITING_PROVIDER_PRIORITY=llm,azure_vision,tesseract
OCR_TABLE_PROVIDER_PRIORITY=builtin,azure_vision,aws_textract
OCR_TIMEOUT_SECONDS=120
OCR_MAX_RETRIES=2
TESSERACT_CMD=                      # blank = look up on PATH
TESSDATA_PREFIX=

GOOGLE_VISION_CREDENTIALS_JSON=     # inline service-account JSON or file path
GOOGLE_VISION_ENABLED=false

AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=
AZURE_VISION_ENABLED=false

AWS_TEXTRACT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_TEXTRACT_ENABLED=false

YANDEX_VISION_API_KEY=
YANDEX_VISION_FOLDER_ID=
YANDEX_VISION_ENABLED=false

# -----------------------------------------------------------------------------
# Translation providers (comma separated priority list)
# Available: deepl, google_translate, yandex_translate, azure_translator,
#            llm, argos (local, offline), echo (tests only)
# -----------------------------------------------------------------------------
TRANSLATION_PROVIDER_PRIORITY=argos,deepl,google_translate,llm
TRANSLATION_TIMEOUT_SECONDS=60
TRANSLATION_MAX_CHARS_PER_REQUEST=4000
TRANSLATION_CACHE_TTL_SECONDS=604800

DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2

GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_PROJECT_ID=

YANDEX_TRANSLATE_API_KEY=
YANDEX_TRANSLATE_FOLDER_ID=

AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# -----------------------------------------------------------------------------
# LLM provider (used for hard OCR cases, handwriting, structured extraction)
# Documents are always passed as DATA. See docs/security/llm-safety.md.
# -----------------------------------------------------------------------------
LLM_PROVIDER=anthropic              # anthropic | openai_compatible | disabled
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_SCHEMA_RETRIES=2
LLM_DAILY_COST_LIMIT_USD=50

# -----------------------------------------------------------------------------
# Processing behaviour
# -----------------------------------------------------------------------------
# When true, external OCR/translation providers are refused entirely.
LOCAL_ONLY_PROCESSING=false
INPAINT_STRATEGY=auto               # auto | telea | ns | solid | overlay
ADVANCED_INPAINT_ENABLED=false
PREVIEW_MAX_DIMENSION=1600
THUMBNAIL_MAX_DIMENSION=320
PROCESSING_MAX_DIMENSION=4000
FONT_DIR=./assets/fonts

# -----------------------------------------------------------------------------
# Retention (hours). Lifecycle worker enforces these.
# -----------------------------------------------------------------------------
RETENTION_GUEST_HOURS=24
RETENTION_FREE_HOURS=168
RETENTION_PRO_HOURS=2160
RETENTION_BUSINESS_HOURS=8760
RETENTION_INTERMEDIATE_HOURS=6
RETENTION_TRASH_HOURS=720

# -----------------------------------------------------------------------------
# Backups (production `backup` container — scripts/backup-loop.sh)
# -----------------------------------------------------------------------------
BACKUP_INTERVAL=21600          # seconds between dumps (default 6h)
BACKUP_RETENTION_DAYS=14

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
SESSION_TTL_SECONDS=2592000
SESSION_COOKIE_NAME=picglot_session
SESSION_COOKIE_SECURE=false         # true in production (HTTPS only)
SESSION_COOKIE_DOMAIN=
GUEST_COOKIE_NAME=picglot_guest
CSRF_COOKIE_NAME=picglot_csrf
PASSWORD_MIN_LENGTH=10
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
EMAIL_VERIFICATION_TTL_SECONDS=86400
MAGIC_LINK_TTL_SECONDS=900
PASSWORD_RESET_TTL_SECONDS=3600
TOTP_ISSUER=PicGlot

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ENABLED=false

# -----------------------------------------------------------------------------
# Rate limiting  (requests / window seconds)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANON_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=180
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_UPLOAD_PER_HOUR=120
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_SHARE_PER_MINUTE=30

# -----------------------------------------------------------------------------
# Billing
# -----------------------------------------------------------------------------
BILLING_ENABLED=true
BILLING_PROVIDER=stripe             # stripe | yookassa | manual
BILLING_TEST_MODE=true
BILLING_CURRENCY=USD

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=smtp                 # smtp | resend | console
EMAIL_FROM=noreply@picglot.ru
EMAIL_FROM_NAME=PicGlot
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Analytics (no document content is ever sent — see docs/security/privacy-model.md)
# -----------------------------------------------------------------------------
ANALYTICS_ENABLED=true
ANALYTICS_PROVIDERS=internal        # internal,posthog,ga4,yandex_metrica
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.posthog.com
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
YANDEX_METRICA_COUNTER_ID=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=picglot-api
METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Feature flags (runtime overrides live in the feature_flags table)
# -----------------------------------------------------------------------------
FEATURE_BATCH=true
FEATURE_PUBLIC_API=true
FEATURE_WEBHOOKS=true
FEATURE_SHARING=true
FEATURE_TEAMS=true
FEATURE_PWA=true
FEATURE_HANDWRITING=true
FEATURE_TABLES=true
FEATURE_RECEIPTS=true
ENABLED_TOOLS=image-translator,translate-photo,screenshot-translator,image-to-text,jpg-to-word,image-to-excel,handwriting-to-text,pdf-translator,pdf-ocr,document-scanner,receipt-scanner,invoice-ocr,batch

# -----------------------------------------------------------------------------
# Quotas
# -----------------------------------------------------------------------------
GUEST_FREE_PAGES=3
FREE_MONTHLY_CREDITS=10
PRO_MONTHLY_CREDITS=1000
BUSINESS_MONTHLY_CREDITS=5000

# -----------------------------------------------------------------------------
# Admin / seed (never set real production credentials here)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@picglot.example
SEED_ADMIN_PASSWORD=Sup3r!Seed-2026
SEED_DEMO_EMAIL=demo@picglot.example
SEED_DEMO_PASSWORD=Tr1al!Seed-2026
SEED_ENABLED=true

# -----------------------------------------------------------------------------
# Web app (Next.js) — variables prefixed NEXT_PUBLIC_ are exposed to the browser
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME=PicGlot
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Origin of the object store, same value as S3_PUBLIC_ENDPOINT_URL. Named in
# the Content-Security-Policy: leave it empty and every image served straight
# from storage is blocked by the browser before a request is made.
NEXT_PUBLIC_S3_URL=http://localhost:9000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_ENABLED_LOCALES=en,ru,es,de,fr,pt,tr,id,pl,uk
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_YANDEX_METRICA_ID=
NEXT_PUBLIC_SENTRY_DSN=
API_INTERNAL_URL=http://localhost:8000
